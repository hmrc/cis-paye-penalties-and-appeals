# microservice specific routes

# CIS routes
POST        /cis/appeal              uk.gov.hmrc.cispayepenaltiesandappeals.controllers.ManageCisController.createCisAppeal()
POST        /cis/penalties           uk.gov.hmrc.cispayepenaltiesandappeals.controllers.ManageCisController.getCisAppealablePenalties()
POST        /cis/penalty             uk.gov.hmrc.cispayepenaltiesandappeals.controllers.ManageCisController.getCisAppealablePenalty()
POST        /cis/taxpayer            uk.gov.hmrc.cispayepenaltiesandappeals.controllers.ManageCisController.getCisTaxpayer()

# PAYE routes
POST        /paye/appeal             uk.gov.hmrc.cispayepenaltiesandappeals.controllers.ManagePayeController.createPayeAppeal()
POST        /paye/penalties          uk.gov.hmrc.cispayepenaltiesandappeals.controllers.ManagePayeController.getPayeAppealablePenalties()
POST        /paye/penalty            uk.gov.hmrc.cispayepenaltiesandappeals.controllers.ManagePayeController.getPayeAppealablePenalty()
